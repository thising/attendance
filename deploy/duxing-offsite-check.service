[Unit]
Description=Check Duxing readable NAS archives and encrypted recovery data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/duxing/nas_backup.py --config /etc/duxing/nas-backup.json --mode check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duxing/backup-state
TimeoutStartSec=50min
Nice=10
