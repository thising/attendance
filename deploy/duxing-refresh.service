[Unit]
Description=Refresh Duxing current-month public report snapshots

[Service]
Type=oneshot
User=duxing
Group=duxing
WorkingDirectory=/opt/duxing/current
EnvironmentFile=/etc/duxing/ams.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/duxing/venv/bin/python manage.py refresh_due_public_reports
StateDirectory=duxing
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duxing
