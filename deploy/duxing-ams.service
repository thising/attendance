[Unit]
Description=Duxing student conduct management (ams.unzip.work)
After=network.target

[Service]
Type=simple
User=duxing
Group=duxing
WorkingDirectory=/opt/duxing/current
EnvironmentFile=/etc/duxing/ams.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/duxing/venv/bin/gunicorn --bind 127.0.0.1:8765 --workers 2 --threads 2 --timeout 60 attendance.wsgi:application
Restart=on-failure
RestartSec=3
StateDirectory=duxing
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duxing

[Install]
WantedBy=multi-user.target
